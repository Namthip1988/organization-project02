rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default Deny All
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidUser(data, userId) {
      return data.uid == userId
        && data.email is string && data.email.size() <= 256
        && (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 128))
        && (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 1024))
        && (!('monthlyBudget' in data) || (data.monthlyBudget is number && data.monthlyBudget >= 0 && data.monthlyBudget <= 1000000000))
        && (!('currency' in data) || (data.currency is string && data.currency.size() <= 10));
    }

    function isValidTransaction(data, userId) {
      return data.userId == userId
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 200
        && data.amount is number && data.amount > 0 && data.amount <= 1000000000
        && (data.type == 'income' || data.type == 'expense')
        && data.category is string && data.category.size() >= 1 && data.category.size() <= 100
        && data.date is string && data.date.matches('^\\d{4}-\\d{2}-\\d{2}$')
        && data.month is string && data.month.matches('^\\d{4}-\\d{2}$')
        && (!('paymentMethod' in data) || (data.paymentMethod is string && data.paymentMethod.size() <= 50))
        && (!('notes' in data) || (data.notes is string && data.notes.size() <= 1000));
    }

    function isValidBudget(data, userId) {
      return data.userId == userId
        && data.month is string && data.month.matches('^\\d{4}-\\d{2}$')
        && data.amount is number && data.amount >= 0 && data.amount <= 1000000000;
    }

    // Connection test document
    match /test/{docId} {
      allow read: if true;
    }

    // User document and private subcollections
    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if false; // Blanket user list is forbidden
      allow create: if isOwner(userId) && isValidId(userId) && isValidUser(incoming(), userId);
      allow update: if isOwner(userId) && isValidId(userId) && isValidUser(incoming(), userId)
        && incoming().uid == existing().uid;
      allow delete: if isOwner(userId) && isValidId(userId);

      // Transactions subcollection
      match /transactions/{transactionId} {
        allow get: if isOwner(userId) && isValidId(transactionId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(transactionId) && isValidTransaction(incoming(), userId);
        allow update: if isOwner(userId) && isValidId(transactionId) && isValidTransaction(incoming(), userId)
          && incoming().userId == existing().userId;
        allow delete: if isOwner(userId) && isValidId(transactionId);
      }

      // Budgets subcollection
      match /budgets/{month} {
        allow get: if isOwner(userId) && isValidId(month);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(month) && isValidBudget(incoming(), userId);
        allow update: if isOwner(userId) && isValidId(month) && isValidBudget(incoming(), userId)
          && incoming().userId == existing().userId;
        allow delete: if isOwner(userId) && isValidId(month);
      }
    }
  }
}
