{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile document storing personal preference, budget, and metadata",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 256 },
        "displayName": { "type": "string", "maxLength": 128 },
        "photoURL": { "type": "string", "maxLength": 1024 },
        "monthlyBudget": { "type": "number" },
        "currency": { "type": "string", "maxLength": 10 },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["uid", "email"]
    },
    "Transaction": {
      "title": "Transaction",
      "description": "An income or expense transaction record",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "minLength": 1, "maxLength": 200 },
        "amount": { "type": "number" },
        "type": { "type": "string", "enum": ["income", "expense"] },
        "category": { "type": "string", "minLength": 1, "maxLength": 100 },
        "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "month": { "type": "string", "pattern": "^\\d{4}-\\d{2}$" },
        "paymentMethod": { "type": "string", "maxLength": 50 },
        "notes": { "type": "string", "maxLength": 1000 },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["userId", "title", "amount", "type", "category", "date", "month"]
    },
    "Budget": {
      "title": "Budget",
      "description": "Monthly budget target and category allocations for a specific user and month",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128 },
        "month": { "type": "string", "pattern": "^\\d{4}-\\d{2}$" },
        "amount": { "type": "number" },
        "categoryBudgets": { "type": "object" },
        "updatedAt": { "type": "string" }
      },
      "required": ["userId", "month", "amount"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "User profile with display settings and global budget"
    },
    "/users/{userId}/transactions/{transactionId}": {
      "schema": { "$ref": "#/entities/Transaction" },
      "description": "Subcollection of all income and expense transactions for this user"
    },
    "/users/{userId}/budgets/{month}": {
      "schema": { "$ref": "#/entities/Budget" },
      "description": "Subcollection of monthly budget targets for this user"
    }
  }
}
